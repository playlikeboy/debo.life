# Names only. Never commit real values.
# Locally, `neon env pull` in the repo root writes most of these into `.env` (git-ignored).
# Deployed, they live in the host's secret store (`wrangler secret put`).

# Database: Neon Postgres with pgvector
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Sign-in: Neon Auth (managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Not from Neon. Make it yourself: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# File storage: Neon Object Storage (S3 API)
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Model calls (@debo/llm): Anthropic is tried first, then the Neon AI Gateway
ANTHROPIC_API_KEY=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
# Optional: AI tokens one person may use per day (UTC) on our key. Default 40000.
DAILY_TOKEN_LIMIT=

# Key used to encrypt users' own API keys (BYOK). 32 random bytes, base64.
BYOK_ENCRYPTION_KEY=

# Voice (apps/voice-agent, switched off until all three are set)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Connectors (@debo/connectors, switched off until COMPOSIO_API_KEY is set)
COMPOSIO_API_KEY=
COMPOSIO_GOOGLECALENDAR_AUTH_CONFIG_ID=
COMPOSIO_GOOGLECALENDAR_VERSION=
