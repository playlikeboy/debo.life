# Copy to .env.local. Never commit real values.
# Only the landing page exists today and it needs none of these.
# They are listed so every agent uses the same names later.

# Database (Postgres with pgvector)
DATABASE_URL=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# File storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Model access for users on a paid plan (our key)
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=

# Key used to encrypt users' own API keys (BYOK). 32 random bytes, base64.
BYOK_ENCRYPTION_KEY=

# Voice
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Connectors
COMPOSIO_API_KEY=
