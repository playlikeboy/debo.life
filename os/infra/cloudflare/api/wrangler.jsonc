{
  // debo-os-api: a Worker that fronts one container running the Debo OS API
  // (Hono + in-process task worker). Run from os/infra/cloudflare:
  //   npx wrangler deploy -c api/wrangler.jsonc
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "debo-os-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Preview first: reachable at https://debo-os-api.<account>.workers.dev
  "workers_dev": true,
  "preview_urls": false,

  // Later switch to api.debo.life: uncomment, redeploy, and set the plain vars
  // PUBLIC_API_URL / ALLOWED_ORIGINS below to the final URLs.
  // "routes": [{ "pattern": "api.debo.life", "custom_domain": true }],

  "containers": [
    {
      "class_name": "DeboApi",
      "image": "./Dockerfile",
      // The repo root: the API imports TypeScript packages from ../packages.
      "image_build_context": "../../../..",
      // basic = 1/4 vCPU, 1 GiB. The API is one bundled file and does not start PGlite when DATABASE_URL is set.
      // If it runs out of memory, use "standard-1" (1/2 vCPU, 4 GiB).
      "instance_type": "basic",
      // Run one API instance (upstream rule). The Worker always addresses the same one.
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "DeboApi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeboApi"] }],

  // Private path to the browser worker. No public URL is involved.
  "services": [{ "binding": "BROWSER", "service": "debo-os-browser" }],

  // Keeps durable tasks moving: wakes the container, which restarts the task loop.
  // Remove to let the container sleep when idle (tasks then wait for the next visit).
  "triggers": { "crons": ["*/5 * * * *"] },

  "observability": { "enabled": true },

  "vars": {
    "WORKSPACE_MODE": "live",
    "AGENT_BACKEND": "model",
    // An Anthropic model, so no OpenAI key is needed. Same family the journal uses.
    "MODEL": "anthropic/claude-haiku-5-5",
    "AUTH_MODE": "neon",
    // os keeps its own table, os.records, in this schema of Debo's Neon database.
    "OS_DB_SCHEMA": "os",
    "TASK_WORKER_ENABLED": "true",
    "TRUST_PROXY": "true",
    "API_SLEEP_AFTER": "10m",
    // Overridden at deploy time with --var (the workflow does this).
    "PUBLIC_API_URL": "https://debo-os-api.workers.dev",
    "ALLOWED_ORIGINS": "https://debo-os-app.workers.dev"
  }
  // Secrets are set with `wrangler secret put` or --secrets-file, never here.
  // See ../README.md for the full list.
}
