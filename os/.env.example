# Copy to .env. Sample mode stays on localhost and uses fictional data.
# Every mode requires a server-only CopilotKit Intelligence project key.
WORKSPACE_MODE=sample
AGENT_BACKEND=sample
PORT=8787
HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DATA_DIR=.openfuse
TASK_WORKER_ENABLED=true
# Rate limiting keys on the socket address. Set true only behind a reverse proxy that
# overwrites X-Forwarded-For; otherwise callers can spoof it.
# TRUST_PROXY=false

# General delegated work: select AGENT_BACKEND=model and a provider/model.
# MODEL=openai/your-model-id
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Keyless public web search is enabled by default. Queries and task/chat context go to Parallel.
# Disable on the API and any separate task worker with WEB_SEARCH_ENABLED=false.
WEB_SEARCH_ENABLED=true
# Optional OpenAI-compatible Responses API endpoint:
# OPENAI_BASE_URL=
# Optional Anthropic endpoint override; a trailing /v1 is stripped (the SDK adds /v1 itself):
# ANTHROPIC_BASE_URL=
# Optional Google AI endpoint override; a trailing /v1beta is stripped (the SDK adds /v1beta itself):
# GOOGLE_GENERATIVE_AI_BASE_URL=
# For a gateway model ID such as vendor/model, set MODEL=openai/vendor/model.
# Providers whose /responses tool loop is incomplete (e.g. DeepSeek) can opt
# into the Chat Completions wire format instead:
# OPENAI_CHAT_COMPLETIONS=true

# Live Google workspace: WORKSPACE_MODE=live, AGENT_BACKEND=model.
# OPENFUSE_ACCESS_KEY=  # random secret, at least 24 characters
# Per-person accounts with Neon Auth (see docs/AUTH.md). Instead of the access key:
# AUTH_MODE=neon
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# OS_DB_SCHEMA=os  # records live in os.records, not public.records
# TOKEN_ENCRYPTION_KEY=  # 32 random bytes encoded as base64
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAuth callback is PUBLIC_API_URL + /api/google/callback

# Optional separate task worker; all processes share DATA_DIR for PDF files.
# DATABASE_URL=postgresql://...
# Set TASK_WORKER_ENABLED=false on the API when using pnpm dev:worker.

# Browser worker (separate from the task worker):
# BROWSER_WORKER_URL=http://127.0.0.1:8790
# WORKER_TOKEN=  # same random 32+ character secret in API and browser worker
WORKER_DATA_DIR=.openfuse/browser-profiles
WORKER_HOST=127.0.0.1

# An optional external raw AG-UI agent replaces conversational routing only.
# AGENT_BACKEND=agui
# AGENT_URL=https://your-agent.example/run
# AGENT_TOKEN=
# OpenBot's Intelligence runtime is not this raw AG-UI URL. See its adapter docs.

# Conversations are stored in Debo's own database (DATABASE_URL, or the local data
# directory). No CopilotKit Intelligence key is needed or used. If CPK_INTELLIGENCE_API_KEY
# is set it is ignored, and the server says so at startup.

# Telemetry is OFF. Nothing about usage leaves the server unless you set this to on.
# DEBO_TELEMETRY=off
# DO_NOT_TRACK=1 still forces it off even when DEBO_TELEMETRY=on.

# Optional private Docker Linux computer (separate from the browser).
# Build first: docker build -t openfuse-computer:local apps/computer
# Docker must be reachable from the API and any separate task worker.
COMPUTER_ENABLED=false
COMPUTER_IMAGE=openfuse-computer:local
# Optional deployment name shared by API and worker. When unset, a new install keeps a random
# name in DATA_DIR; an install created before that keeps a hash of PUBLIC_API_URL.
# COMPUTER_DEPLOYMENT_ID=  # e.g. from `openssl rand -hex 12`
# Optional scoped Docker engine, e.g. DOCKER_CONTEXT=colima-openfuse
# Or run each owner's computer in an E2B Desktop sandbox instead of Docker
# (graphical desktop with internet access; see docs/COMPUTER.md):
# COMPUTER_PROVIDER=e2b-desktop  # default: docker
# E2B_API_KEY=  # server-only; required for e2b-desktop, never sent into the sandbox
# COMPUTER_DEPLOYMENT_ID is required for e2b-desktop: sandboxes are matched across the E2B team
# COMPUTER_E2B_TEMPLATE=desktop  # optional custom template built from "desktop"
# E2B_DOMAIN=  # only when not using the default E2B cluster

# Optional Jev interaction choices: off (default), sample scripted decisions, or live SDK.
JEV_MODE=off
# live sends the latest user message, agent-written context and candidate choices to TypeSafe;
# see docs/demos/jev-generative-ui.md#what-live-mode-sends-to-typesafe
# TYPESAFE_API_KEY=  # server-only; required for JEV_MODE=live
# JEV_MODEL=jev-1.13.0

# Connect your apps (Gmail, Slack, Notion, GitHub and more) through Composio. Leave blank to turn it
# off; the Apps screen then says "Connecting apps is not set up yet". Server-only. Composio holds the
# sign-in to each app. See docs/CONNECTORS.md for the dashboard settings and the plan limits.
# COMPOSIO_API_KEY=
# Sample workspace only: practice connectors that never reach a real app.
# DEBO_SAMPLE_CONNECTORS=1

# Talk to Debo (voice). Leave blank to turn voice off; the Talk tab then says it is not set up.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# A long random string (32+ characters) shared with the voice agent: openssl rand -hex 32
# VOICE_AGENT_SECRET=

# Debo's personal brain: journal, answers from your own entries, and What Debo knows.
# Without a Debo database these features say "not set up"; nothing else is affected.
# DEBO_DATABASE_URL=  # Neon Postgres with Debo's sources/chunks tables (falls back to DATABASE_URL in live mode only)
# ANTHROPIC_API_KEY=  # answers; or the Neon AI Gateway pair below
# NEON_AI_GATEWAY_BASE_URL=
# NEON_AI_GATEWAY_TOKEN=  # also used for meaning search
# MEM0_API_KEY=  # hosted Mem0 for What Debo knows; without it, memories are off
# DAILY_TOKEN_LIMIT=40000  # tokens per person per day on the server's AI key

# Journal voice notes and videos (see docs/JOURNAL-MEDIA.md). Without the R2 values the journal is text only.
# R2_ACCOUNT_ID=  # your Cloudflare account id
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=debo-journal-media
# CF_AI_API_TOKEN=  # Workers AI, writes out recordings and speech; without it recordings are kept but not written out
# Needs ffmpeg on the server. In sample mode DEBO_DEV_MEMORY=1 uses a fake bucket and a fake speech engine.
