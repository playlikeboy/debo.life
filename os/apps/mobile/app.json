{
  "expo": {
    "name": "Debo",
    "slug": "debo",
    "scheme": "debo",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "life.debo.app" },
    "android": { "package": "life.debo.app" },
    "web": { "bundler": "metro", "name": "Debo: remembers your life" },
    "plugins": [
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Debo uses the microphone only while you are talking to it. It never keeps the recording."
        }
      ]
    ]
  }
}
