{
  "name": "@openfuse/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web --port 8081",
    "build:web": "expo export --platform web --output-dir dist/web",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "build:android": "expo export --platform android --output-dir dist/android",
    "typecheck": "tsc --noEmit",
    "sync:tokens": "node ../../scripts/sync-astryx-tokens.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "13.0.0",
    "@copilotkit/react-native": "1.70.1",
    "@expo/metro-runtime": "~6.1.2",
    "@livekit/react-native": "3.1.0",
    "@livekit/react-native-expo-plugin": "1.1.0",
    "@livekit/react-native-webrtc": "150.1.1",
    "expo": "~54.0.0",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.0",
    "livekit-client": "2.24.0",
    "lucide-react-native": "^0.468.0",
    "markdown-it": "14.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-blob-util": "^0.22.2",
    "react-native-get-random-values": "~1.11.0",
    "react-native-markdown-renderer": "4.1.1",
    "react-native-pdf": "^7.0.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-butter": "0.7.16",
    "@config-plugins/react-native-blob-util": "^12.0.0",
    "@config-plugins/react-native-pdf": "^12.0.0",
    "@types/markdown-it": "14.1.2",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
