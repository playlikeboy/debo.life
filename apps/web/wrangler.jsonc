{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Next.js on Cloudflare Workers through the OpenNext adapter.
  // See docs/DECISIONS.md and docs/SETUP.md.
  "name": "debo-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "debo.life", "custom_domain": true },
    { "pattern": "www.debo.life", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding the OpenNext adapter uses; name must match the worker.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "debo-web"
    }
  ],
  "hyperdrive": [
    {
      // Pools connections to Neon Postgres (direct, non-pooled connection string).
      // For local `preview`, set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "binding": "HYPERDRIVE",
      "id": "c242d9f9452e495baac54cc4019ce392"
    }
  ]
}
