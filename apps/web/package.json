    "test": "vitest run src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@copilotkit/react-core": "1.85.0",
    "@copilotkit/react-ui": "1.85.0",
    "@copilotkit/runtime": "1.85.0",
    "@debo/db": "workspace:*",
    "@debo/ingest": "workspace:*",
    "@debo/llm": "workspace:*",
    "@debo/memory": "workspace:*",
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource-variable/figtree": "^5.2.0",
    "@neon/auth": "0.8.2",
    "@opennextjs/cloudflare": "1.20.16",
    "fflate": "0.8.3",
    "inngest": "4.26.2",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "wrangler": "4.159.0"
  }
